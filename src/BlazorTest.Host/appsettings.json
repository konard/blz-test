{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "LiteDB",
    "LiteDB": {
  "ConnectionString": "Filename=../../data/blazortest.db;Connection=shared",
      "InitializeOnStartup": true,
      "SeedDefaultData": true
    }
  },

  "Authentication": {
    "Jwt": {
      "SecretKey": "your-secret-key-at-least-32-characters-long-for-security-change-this-in-production",
      "Issuer": "BlazorTest",
      "Audience": "BlazorTest.Clients",
      "AccessTokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7,
      "RotateRefreshTokens": true
    },
    "Cookie": {
  "Name": ".BlazorTest.Auth",
      "HttpOnly": true,
      "SecurePolicy": "SameAsRequest",
      "SameSite": "Strict",
      "ExpirationDays": 7
    },
    "ExternalProviders": {
      "Google": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "Enabled": false,
        "ClientId": "",
        "ClientSecret": "",
        "TenantId": "common"
      }
    }
  },

  "Identity": {
    "DefaultAdmin": {
      "UserName": "admin",
  "Email": "admin@blazortest.local",
      "Password": "Admin@123456",
      "Roles": ["Administrator"]
    },
    "PasswordOptions": {
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredLength": 8
    },
    "LockoutOptions": {
      "AllowedForNewUsers": true,
      "DefaultLockoutTimeSpan": "00:15:00",
      "MaxFailedAccessAttempts": 5
    }
  },

  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": ["en-US", "ru-RU"],
    "ResourcesPath": "wwwroot/localization",
    "FallbackToDefault": true
  }
}

