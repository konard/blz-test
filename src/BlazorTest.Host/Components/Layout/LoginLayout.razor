@inherits LayoutComponentBase

<MudLayout>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 100vh;">
            <MudPaper Class="pa-8" Elevation="4" Style="width: 100%;">
                <div class="d-flex flex-column align-center mb-6">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                    <MudText Typo="Typo.h4" Align="Align.Center">BlazorTest</MudText>
                    <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Secondary">Framework</MudText>
                </div>
                @Body
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>
